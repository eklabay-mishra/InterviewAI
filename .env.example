# InterviewAI Enterprise Environment Configuration

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=interview_ai_super_secret_enterprise_key_2026_x89a

# Database Configuration (MySQL / SQLite Fallback)
